{
  "name": "german-reading-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-dev-use-system-ca.cjs",
    "dev:clean": "node scripts/free-dev-port.cjs && node scripts/next-dev-use-system-ca.cjs",
    "build": "next build",
    "vercel-build": "vitest run && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "vocab-split:try": "vitest run --config vitest.live.config.ts src/lib/articleAnalysis/vocabularySplitCustomArticle.live.test.ts --testTimeout=600000",
    "vocab-only-no-grammar:try": "vitest run --config vitest.live.config.ts src/lib/articleAnalysis/vocabularyOnlyNoGrammarExperiment.live.test.ts --testTimeout=600000",
    "vocab-hypothesis:try": "vitest run --config vitest.live.config.ts src/lib/articleAnalysis/vocabularyHypothesisCompare.live.test.ts --testTimeout=900000",
    "audit:ai-vocab-pos": "node --use-system-ca scripts/audit-ai-vocabulary-pos-timeline.mjs",
    "db:cleanup": "node scripts/cleanup-system-grammar-and-summaries.mjs",
    "vercel": "npx vercel",
    "vercel:prod": "npx vercel --prod",
    "vercel:prod:system-ca": "node scripts/vercel-prod-use-system-ca.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "cheerio": "^1.2.0",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
