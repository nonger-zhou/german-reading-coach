# 复制本文件为 .env.local 并填入 Supabase 控制台中的值（勿将真实 key 提交到仓库）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI：仅服务端 API Route 使用，勿使用 NEXT_PUBLIC_ 前缀。
OPENAI_API_KEY=

# 链接导入（可选）：生产环境若 Node 对个别站点 HTTPS 校验失败（浏览器却能打开），且网络可信，可设为 1 强制放宽 TLS 重试（存在中间人风险）。本地 next dev 默认已在 TLS 校验失败时自动放宽重试，通常不必设置。
# ALLOW_INSECURE_IMPORT_TLS=1

# OpenAI API（可选）：本机 Node 访问 api.openai.com 若因 HTTPS 校验失败而报 Connection error，可在信任网络下设为 1；生产务必谨慎。本地 dev 若已设 ALLOW_INSECURE_IMPORT_TLS=1，也会顺带放宽对 OpenAI 的 TLS（见 createServerOpenAIClient）。
# ALLOW_INSECURE_OPENAI_TLS=1

# OpenAI 走代理（可选）：无法直连 api.openai.com 时（如 Connection error / fetch failed），填本地代理，例如 http://127.0.0.1:7890。也可用系统变量 HTTPS_PROXY；OPENAI_HTTPS_PROXY 优先。
# OPENAI_HTTPS_PROXY=http://127.0.0.1:7890

# TLS / 证书：若报错 unable to verify the first certificate（常见于 HTTPS 代理 MITM、杀毒/企业根证书），`npm run dev` 在 Node 20.19+ / 22.9+ 下会自动附加 --use-system-ca。也可自行设置 NODE_OPTIONS=--use-system-ca 后启动；仍失败再考虑 ALLOW_INSECURE_OPENAI_TLS=1（仅可信网络）。
